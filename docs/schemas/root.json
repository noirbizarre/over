{
  "$id": "https://noirbizarre.github.io/over/schemas/root.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Over repository configuration",
  "description": "Configuration for Over. Filesystem, inheritance, and template validation is performed by over lint and runtime commands.",
  "type": "object",
  "properties": {
    "data": {
      "description": "Consumer-owned metadata; nested values are not interpreted by Over.",
      "type": "object",
      "additionalProperties": true
    },
    "default_overlay": {
      "description": "Repository-relative overlay selected when no explicit selection is supplied.",
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "description": "Human-readable description of this overlay.",
      "type": [
        "string",
        "null"
      ]
    },
    "exclude": {
      "description": "Source patterns excluded from materialization; a string or a list.",
      "allOf": [
        {
          "$ref": "#/definitions/StringOrList"
        }
      ]
    },
    "format": {
      "description": "Preferred format for descriptors written by over new: toml or yaml.",
      "anyOf": [
        {
          "$ref": "#/definitions/Format"
        },
        {
          "type": "null"
        }
      ]
    },
    "git": {
      "description": "Clone one repository or map destination paths to repository declarations.",
      "anyOf": [
        {
          "$ref": "#/definitions/AllGitForms"
        },
        {
          "type": "null"
        }
      ]
    },
    "hooks": {
      "allOf": [
        {
          "$ref": "#/definitions/Hooks"
        }
      ],
      "default": {
        "install": [],
        "post-apply": [],
        "post-clone": [],
        "post-init": []
      }
    },
    "map": {
      "description": "Relocate source directory prefixes independently of the base target.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/DirectoryMapping"
      }
    },
    "mode": {
      "description": "Default materialization strategy for this scope.",
      "allOf": [
        {
          "$ref": "#/definitions/MaterializationKind"
        }
      ]
    },
    "overlays": {
      "description": "Directories or glob patterns declaring overlays without local descriptors.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/OverlayDeclaration"
      }
    },
    "permissions": {
      "description": "Octal permissions for managed content.",
      "allOf": [
        {
          "$ref": "#/definitions/FileMode"
        }
      ]
    },
    "repository": {
      "description": "Canonical literal Git remote; SCP-style remotes and local paths are supported.",
      "type": "string"
    },
    "rules": {
      "description": "Ordered declaration-relative policy overrides.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Rule"
      }
    },
    "sync": {
      "$ref": "#/definitions/SyncConfig"
    },
    "target": {
      "description": "Destination directory. Omit to inherit the ancestor's target (default: ~).",
      "type": "string"
    },
    "uses": {
      "description": "Compose these repository-relative overlay names in declaration order.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AllGitForms": {
      "description": "All supported shapes for the `git` field in an overlay config.\n\nTried in order by serde's `#[serde(untagged)]`:\n1. **Single** – a bare URL string *or* an object with a `url` key\n   (both handled by [`GitRepoConfig`]'s own deserializer).\n   The repo is cloned to the overlay target root (path `\".\"`).\n2. **Map** – a map of destination paths to repo configs (current behaviour).\n\n*Edge case*: if you literally need a destination path called `\"url\"`, add\nat least one other path entry so the map variant is selected instead.",
      "anyOf": [
        {
          "description": "A single repo config (string URL or detailed object).",
          "allOf": [
            {
              "$ref": "#/definitions/GitRepoConfig"
            }
          ]
        },
        {
          "description": "Map of `<path> → <repo config>`.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/GitRepoConfig"
          },
          "not": {
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "DirectoryMapping": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "target"
      ]
    },
    "FileMode": {
      "type": "string",
      "pattern": "^(0o)*\\+?0*([0-7]{1,10}|[0-3][0-7]{10})$"
    },
    "Format": {
      "description": "Supported overlay descriptor formats.",
      "type": "string",
      "enum": [
        "toml",
        "yaml"
      ]
    },
    "GitConfig": {
      "description": "Arbitrary git config entries.\n\nSupports two forms that can be mixed:\n- **Flat dotted keys**: `\"user.email\" = \"me@example.com\"`\n- **Nested sections**: `{ user: { email: \"me@example.com\" } }`\n\nInternally flattened to dotted key → value pairs.",
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "GitRepoConfig": {
      "description": "Configuration for a single git repository entry in an overlay.\n\nSupports two forms:\n- **Simple**: just a URL string (e.g. `\".tmux/plugins/tpm\" = \"https://...\"`)\n- **Detailed**: an object with `url` and optional fields",
      "anyOf": [
        {
          "description": "Just a URL string.",
          "type": "string"
        },
        {
          "description": "Full object with `url` and optional fields.",
          "type": "object",
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "config": {
              "anyOf": [
                {
                  "$ref": "#/definitions/GitConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "per_worktree_config": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "recurse_submodules": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "remotes": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "$ref": "#/definitions/RemoteConfig"
              }
            },
            "rev": {
              "type": [
                "string",
                "null"
              ]
            },
            "tag": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": "string"
            },
            "worktree": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "worktree_config": {
              "anyOf": [
                {
                  "$ref": "#/definitions/GitConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "worktrees": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "$ref": "#/definitions/WorktreeEntry"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "url"
          ]
        }
      ]
    },
    "Hook": {
      "description": "Preserve the shorthand on serialization without exposing executable values in Debug.",
      "anyOf": [
        {
          "$ref": "#/definitions/HookCommand"
        },
        {
          "$ref": "#/definitions/HookDefinition"
        }
      ]
    },
    "HookCommand": {
      "type": "string",
      "pattern": "^[^\\u0000]*[^\\s\\u0000][^\\u0000]*$"
    },
    "HookDefinition": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/definitions/HookCommand"
        },
        "cwd": {
          "type": "string",
          "pattern": "^[^\\u0000]*$"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          },
          "default": {},
          "propertyNames": {
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "pattern": "^[oO][vV][eE][rR]_[hH][oO][oO][kK]_[aA][cC][tT][iI][vV][eE]$"
                },
                {
                  "pattern": "^[oO][vV][eE][rR]_[hH][oO][oO][kK]_[eE][vV][eE][nN][tT]$"
                },
                {
                  "pattern": "^[oO][vV][eE][rR]_[rR][eE][pP][oO][sS][iI][tT][oO][rR][yY]_[rR][oO][oO][tT]$"
                },
                {
                  "pattern": "^[oO][vV][eE][rR]_[tT][aA][rR][gG][eE][tT]_[rR][oO][oO][tT]$"
                },
                {
                  "pattern": "^[oO][vV][eE][rR]_[oO][vV][eE][rR][lL][aA][yY]_[nN][aA][mM][eE]$"
                },
                {
                  "pattern": "^[oO][vV][eE][rR]_[oO][vV][eE][rR][lL][aA][yY]_[rR][oO][oO][tT]$"
                },
                {
                  "pattern": "^[oO][vV][eE][rR]_[oO][vV][eE][rR][lL][aA][yY]_[tT][aA][rR][gG][eE][tT]$"
                }
              ]
            },
            "pattern": "^[^=\\u0000]+$"
          }
        },
        "when": {
          "type": "string",
          "pattern": "^[^\\u0000]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "Hooks": {
      "description": "Commands are deliberately hidden from Debug: overlays appear in debug traces.",
      "type": "object",
      "properties": {
        "install": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/Hook"
          }
        },
        "post-apply": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/Hook"
          }
        },
        "post-clone": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/Hook"
          }
        },
        "post-init": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/Hook"
          }
        }
      },
      "additionalProperties": false
    },
    "MaterializationKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "symlink",
            "symlink-directory"
          ]
        },
        {
          "description": "Editable files backed by the overlay repository, not a declared Git clone.",
          "type": "string",
          "const": "checkout"
        }
      ]
    },
    "OverlayDeclaration": {
      "description": "A single root-level overlay/workspace declaration. `path` is a glob\npattern (e.g. `hosts/*`) or a literal path, relative to the repository\nroot. Only the repository root's own descriptor's `overlays:` key is\nread — a directory matched this way cannot itself declare further\n`overlays:` entries (ADR-018: no recursive/nested expansion).",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "RemoteConfig": {
      "description": "Configuration for a git remote.\n\nKnown fields (`url`, `fetch`, `push`, `tagopt`) are typed.\nAny additional keys are captured in `extras` to support tools that write\ncustom options (e.g. `git-delete-merged-branches` adding `dmb-*` keys).",
      "type": "object",
      "properties": {
        "fetch": {
          "description": "Custom fetch refspec (e.g. `+refs/heads/*:refs/remotes/upstream/*`).",
          "type": [
            "string",
            "null"
          ]
        },
        "push": {
          "description": "Custom push refspec.",
          "type": [
            "string",
            "null"
          ]
        },
        "tagopt": {
          "description": "Tag fetching option (e.g. `--tags`, `--no-tags`).",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "The remote URL (required).",
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "url"
      ]
    },
    "Rule": {
      "description": "Both properties share selectors and ordering, but assignments are independent.",
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "$ref": "#/definitions/MaterializationKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "mode": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "properties": {
            "permissions": {
              "not": {
                "type": "null"
              }
            }
          },
          "required": [
            "permissions"
          ]
        }
      ],
      "if": {
        "properties": {
          "path": {
            "pattern": "[*?\\[{]"
          }
        },
        "required": [
          "path"
        ]
      },
      "required": [
        "path"
      ],
      "then": {
        "properties": {
          "mode": {
            "const": "symlink-directory"
          }
        },
        "required": [
          "mode"
        ]
      }
    },
    "StringOrList": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "SyncConfig": {
      "description": "Opt-in remote synchronization of the repository containing Over's source.",
      "type": "object",
      "properties": {
        "pull": {
          "type": "boolean",
          "default": false
        },
        "push": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "WorktreeEntry": {
      "description": "Configuration for a single named worktree.\n\nSupports two forms:\n- **Simple**: just a branch name string (e.g. `\"feature-x\" = \"feature/x\"`)\n- **Detailed**: an object with `branch` and optional `config`",
      "anyOf": [
        {
          "description": "Just a branch name string.",
          "type": "string"
        },
        {
          "description": "Full object with `branch` and optional `config`.",
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            },
            "config": {
              "anyOf": [
                {
                  "$ref": "#/definitions/GitConfig"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "branch"
          ]
        }
      ]
    }
  }
}
