# Maintainer: Axel H. <noirbizarre@gmail.com>
#
# Prebuilt binary package. `@VERSION@`, `@SHA256_X86_64@` and
# `@SHA256_AARCH64@` are substituted by .github/workflows/aur.yaml from the
# published release assets, and the result is pushed to the AUR. Edit this
# template, never the PKGBUILD in the AUR repository: that one is
# regenerated at every release.

pkgname=over-bin
_pkgname=over
pkgver=@VERSION@
pkgrel=1
pkgdesc="A git-based file overlay manager (dotfiles as overlays) (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/noirbizarre/over"
license=('MIT')

# What the published binaries actually link. libgit2 and OpenSSL are
# vendored into them, so they are absent here — but zlib and libgcc_s are
# not, and namcap reports an error for every needed library left undeclared.
depends=('gcc-libs' 'glibc' 'zlib')

provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")

# !strip because the release profile already sets `strip = true`, and !debug
# for the same reason: there is no debug data left to split into a -debug
# package, so building one would produce an empty package and a namcap
# warning.
options=('!strip' '!debug')

# The `gnu` archives, not `musl`: an AUR package targets Arch's own glibc,
# and the musl build exists for the systems that are not this one.
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/$pkgver/over_${pkgver}_linux-amd64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/$pkgver/over_${pkgver}_linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

# Fetched separately because the release archive carries no licence file, and
# MIT is not one of the licences Arch keeps in /usr/share/licenses/common —
# so the package has to install the file itself.
source=("LICENSE-$pkgver::$url/raw/$pkgver/LICENSE")
sha256sums=('@SHA256_LICENSE@')

package() {
	# The archive holds `over` and `git-over` at its root, named exactly that.
	# `git-over`'s name is load-bearing: Git resolves `git over` only through
	# an executable called exactly `git-over` on PATH.
	install -Dm755 "$srcdir/over" "$pkgdir/usr/bin/over"
	install -Dm755 "$srcdir/git-over" "$pkgdir/usr/bin/git-over"
	install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

	# Generated by running the extracted binary itself, so the completions
	# cannot describe flags this build does not have.
	"$srcdir/over" completion bash |
		install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/over"
	"$srcdir/over" completion zsh |
		install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_over"
	"$srcdir/over" completion fish |
		install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/over.fish"
}
